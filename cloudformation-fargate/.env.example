# Copy this file to .env.deploy in this same directory and fill in real values.
# .env.deploy is gitignored (matches .gitignore's .env* pattern) — never commit
# real secrets here or in any parameters/*-data.json file.
#
# cdeploy_cloudformation.sh / cdeploy_cloudformation.ps1 auto-load this file if
# present and use these to override the committed parameters/*-data.json
# files' REPLACE_ME_... placeholders for DatabaseMasterPassword and JwtSecret.
# cdeploy_app_only.* and cdestroy_cloudformation.* don't touch the data stack
# and don't need these.

# RDS PostgreSQL master password (8+ characters).
CARECONNECT_DATABASE_MASTER_PASSWORD=

# Backend JWT signing secret (32+ random characters).
CARECONNECT_JWT_SECRET=

# athenahealth (optional). The deploy scripts pass these to the service stack;
# leaving one blank keeps the value the stack already has. cdeploy_app_only.*
# does not load this file, so export them in the shell before running it.
# With CARECONNECT_ATHENA_ENABLED=true the stack requires a practice ID.
CARECONNECT_ATHENA_ENABLED=
CARECONNECT_ATHENA_CLIENT_ID=
# athena's ah-practice form, e.g. a-1.Practice-195900 (preview sandbox).
CARECONNECT_ATHENA_PRACTICE_ID=
CARECONNECT_ATHENA_SCOPES=
CARECONNECT_ATHENA_CLIENT_SECRET=
