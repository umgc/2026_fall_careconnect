      "col": 0,
      "tag": "patient source"
    },
    {
      "id": "transcribe",
      "type": "external",
      "label": "Post-call Transcribe",
      "sublabel": "KVS to WAV per attendee",
      "lane": "capture",
      "col": 2,
      "tag": "scheduled job"
    },
    {
      "id": "stopRec",
      "type": "failure",
      "label": "Stopping Recording",
      "sublabel": "delete pipeline, concatenate",
