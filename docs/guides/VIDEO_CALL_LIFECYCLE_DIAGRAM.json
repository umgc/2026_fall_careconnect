      "from": "sentiment",
      "to": "telemetry",
      "variant": "default",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "teardown-start",
      "from": "terminating",
      "to": "stopRec",
      "variant": "security",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "teardown-retry",
      "from": "stopRec",
      "to": "terminating",
      "variant": "emphasis",
      "fromSide": "left",
      "toSide": "top",
      "via": [[479, 307], [479, 80], [556, 80]]
    },
    {
      "id": "recording-finalized",
      "from": "stopRec",
      "to": "mp4",
      "variant": "default",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "transcription-queued",
      "from": "ended",
      "to": "transcribe",
      "variant": "dashed",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "summary-written",
      "from": "transcribe",
      "to": "summary",
      "variant": "default",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Phase Rail",
      "items": [
        "Only the initiator creates the session; the receiver joins an existing one",
        "Durable join is written before Chime, and reverted if attendee creation fails",
        "The second joiner wins the recording-start election, not the caller"
      ]
    },
    {
      "dot": "amber",
      "title": "Role Split",
      "items": [
        "Sentiment is captured from the patient and shown only to caregivers",
        "Only the recording owner or an admin may stop a recording",
        "In a one-to-one call, either party hanging up ends it for both"
      ]
    },
    {
      "dot": "rose",
      "title": "Deferred Truth",
      "items": [
        "Stopped is not playable; concatenation produces the MP4 afterwards",
        "The first summary is often NO_TRANSCRIPT and is replaced later",
        "Speaker identity comes from the KVS stream, not from diarization"
      ]
    }
  ]
}
