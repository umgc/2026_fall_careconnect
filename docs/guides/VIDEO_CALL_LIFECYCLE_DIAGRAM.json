    {
      "id": "mp4",
      "type": "success",
      "label": "Recording Ready",
      "sublabel": "concatenated MP4",
      "lane": "terminal",
      "col": 1,
      "tag": "presigned"
    },
    {
      "id": "summary",
      "type": "success",
      "label": "Summary Ready",
      "sublabel": "regenerated on first read",
      "lane": "terminal",
      "col": 2,
      "tag": "on demand"
    }
  ],
  "transitions": [
    {
      "id": "capture-start",
      "from": "active",
