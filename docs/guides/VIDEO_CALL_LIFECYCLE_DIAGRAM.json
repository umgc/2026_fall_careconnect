{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "CareConnect Video Call Lifecycle",
    "output": "docs/guides/VIDEO_CALL_LIFECYCLE_DIAGRAM.html",
    "viewBox": [1040, 648],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "phase-rail",
        "label": "Phase rail",
        "focus": ["created", "ringing", "active", "terminating", "ended"],
        "note": "The durable CallSession row from POST /sessions to a fenced Ended that cannot be rejoined."
      },
      {
        "id": "live-capture",
        "label": "Live capture",
        "focus": ["active", "sentiment", "telemetry"],
        "note": "Sentiment is captured from the patient only and pushed to caregivers only."
      },
      {
        "id": "deferred-artifacts",
        "label": "Deferred artifacts",
        "focus": ["terminating", "stopRec", "mp4", "ended", "transcribe", "summary"],
        "note": "Recording teardown can park and retry; transcription and the real summary land after the call."
      }
    ]
  },
  "lanes": [
    { "id": "main", "label": "CallSession phases" },
    { "id": "capture", "label": "Capture + transcription" },
    { "id": "recovery", "label": "Recording teardown" },
    { "id": "terminal", "label": "Durable artifacts" }
  ],
  "states": [
    {
      "id": "created",
      "type": "start",
      "label": "Created",
      "sublabel": "POST /sessions",
