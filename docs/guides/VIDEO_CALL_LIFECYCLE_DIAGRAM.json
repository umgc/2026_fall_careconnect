      "col": 0,
      "step": "01",
      "tag": "initiator only"
    },
    {
      "id": "ringing",
      "type": "waiting",
      "label": "Ringing",
      "sublabel": "WebSocket invitation",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "8s window"
    },
    {
      "id": "active",
      "type": "active",
      "label": "Active",
      "sublabel": "joined, Chime media live",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "POST /join"
    },
    {
      "id": "terminating",
      "type": "active",
      "label": "Terminating",
      "sublabel": "four fenced steps",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "one owner"
    },
    {
      "id": "ended",
      "type": "success",
      "label": "Ended",
      "sublabel": "rejoin fenced off",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "terminal"
    },
    {
      "id": "sentiment",
      "type": "active",
      "label": "Live Sentiment",
      "sublabel": "voice, video, transcript",
