## Copy to .env in this directory (backend/core), then fill in real values.
## Windows:  copy .env.example .env
## macOS/Linux:  cp .env.example .env
## Never commit .env. See docs/guides/TEAM_A_VIDEO_CALL_QUICKSTART.md for IAM + speaker ID.

# Host port for PostgreSQL Docker mapping (default 5432).
# If 5432 is busy, set POSTGRES_PORT=5433 and match JDBC_URI.
POSTGRES_PORT=5432

# PostgreSQL
JDBC_URI=jdbc:postgresql://localhost:5432/careconnect
DB_USER=postgres
DB_PASSWORD=changeme
CORS_ALLOWED_LIST=http://localhost:*

# Security (256+ bit secret)
SECURITY_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Firebase (optional locally)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SENDER_ID=your-firebase-sender-id

# ---------------------------------------------------------------------------
# AWS — local IAM user credentials (NOT the ECS task role)
# Required for Chime, recording, speaker ID, Bedrock, Transcribe.
# See TEAM_A_VIDEO_CALL_QUICKSTART.md §3a for the full IAM policy + group setup.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Call recording (application-dev.properties also sets careconnect.recording.enabled=true)
CARECONNECT_RECORDING_ENABLED=true

# Speaker ID / KVS — leave false unless testing speaker attribution
CARECONNECT_KVS_ENABLED=false
CARECONNECT_KVS_STREAM_POOL_ARN=
# EventBridge → ngrok → local webhook (required for reliable local speaker discovery)
CARECONNECT_KVS_EVENT_WEBHOOK_ENABLED=false
# Must match wire-chime-kvs-eventbridge-local.ps1 ApiKeyValue (default local-dev)
CARECONNECT_KVS_EVENT_WEBHOOK_SHARED_SECRET=local-dev
# CARECONNECT_KVS_STREAM_DISCOVERY_TIMEOUT_MS=60000

# Optional: S3 / billing / email / OAuth (leave placeholders if unused)
S3_BUCKET_NAME=
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
CARECONNECT_EMAIL_PROVIDER=console
CARECONNECT_EMAIL_SENDGRID_API_KEY=
CARECONNECT_EMAIL_FROM=dev@careconnect.local
DEMO_NOTIFICATIONS_EMAIL=
DEMO_NOTIFICATIONS_PHONE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
