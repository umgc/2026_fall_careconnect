## Copy to .env in this directory (backend/core), then fill in real values.
## Windows:  copy .env.example .env
## macOS/Linux:  cp .env.example .env
## Never commit .env. See docs/guides/TEAM_A_VIDEO_CALL_QUICKSTART.md for IAM + speaker ID.

# Host port for PostgreSQL Docker mapping (default 5432).
# If 5432 is busy, set POSTGRES_PORT=5433 and match JDBC_URI.
POSTGRES_PORT=5432

# PostgreSQL
JDBC_URI=jdbc:postgresql://localhost:5432/careconnect
DB_USER=postgres
DB_PASSWORD=changeme
CORS_ALLOWED_LIST=http://localhost:*

# Security (256+ bit secret)
SECURITY_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Firebase (optional locally)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SENDER_ID=your-firebase-sender-id

# ---------------------------------------------------------------------------
# AWS — local IAM user credentials (NOT the ECS task role)
# Required for Chime, recording, speaker ID, Bedrock, Transcribe.
# See TEAM_A_VIDEO_CALL_QUICKSTART.md §3a for the full IAM policy + group setup.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Call recording (application-dev.properties also sets careconnect.recording.enabled=true)
CARECONNECT_RECORDING_ENABLED=true

# Speaker ID / KVS — leave false unless testing speaker attribution
CARECONNECT_KVS_ENABLED=false
CARECONNECT_KVS_STREAM_POOL_ARN=
# EventBridge → ngrok → local webhook (required for reliable local speaker discovery)
CARECONNECT_KVS_EVENT_WEBHOOK_ENABLED=false
# Must match wire-chime-kvs-eventbridge-local.ps1 ApiKeyValue (default local-dev)
CARECONNECT_KVS_EVENT_WEBHOOK_SHARED_SECRET=local-dev
# CARECONNECT_KVS_STREAM_DISCOVERY_TIMEOUT_MS=60000

# Optional: S3 / billing / email / OAuth (leave placeholders if unused)
S3_BUCKET_NAME=
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
CARECONNECT_EMAIL_PROVIDER=console
CARECONNECT_EMAIL_SENDGRID_API_KEY=
CARECONNECT_EMAIL_FROM=dev@careconnect.local
DEMO_NOTIFICATIONS_EMAIL=
DEMO_NOTIFICATIONS_PHONE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# To obtain sandbox credentials go here, create an account and create an application
# https://sandbox.bluebutton.cms.gov/v1/accounts/login
# Both are required for LIVE Medicare (Blue Button). The client ID no longer has a default in the
# properties files: if it is unset the app still starts, with the client ID "not-configured", and
# "Connect Medicare" fails at the CMS sign-in page. Not needed for CARECONNECT_MEDICARE_MODE=mock.
CARECONNECT_MEDICARE_CLIENT_SECRET=
CARECONNECT_MEDICARE_CLIENT_ID=

# Must match a redirect URI registered on the CMS sandbox app exactly (last segment = registration id "medicare").
CARECONNECT_MEDICARE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/medicare

# athenahealth (2-legged / client_credentials). Off unless ATHENA_ENABLED=true.
# Credentials come from the athenahealth Developer Portal app.
ATHENA_ENABLED=false
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
# Only scopes the portal app is actually configured for. Wildcards are rejected and one
# unconfigured scope fails the whole token request with 400 "Invalid Scope".
# The sync imports a resource type only when its scope is granted, e.g. system/Condition.read.
# Leave out system/DocumentReference.read: documents are never imported, so it would be unused access.
ATHENA_SCOPES=system/Patient.read
# ATHENA_PRACTICE_ID: the practice the app is enabled for, or several separated by commas.
# Linking searches each one; a linked patient's practice is read from their chart id.
# Required as the ah-practice search parameter on every FHIR call; bare numeric ids are rejected.
# Deliberately blank: with athena enabled the backend refuses to start until you set it.
# The preview sandbox practice is a-1.Practice-195900.
ATHENA_PRACTICE_ID=
