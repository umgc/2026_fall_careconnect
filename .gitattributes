# Normalize line endings: text files are stored as LF and checked out as LF
# on every platform. This stops CRLF-vs-LF phantom conflicts (see Cononical_10)
# where a Windows working copy (CRLF) collides with a committed LF blob.
* text=auto eol=lf

# Source / config — always LF
*.dart        text eol=lf
*.java        text eol=lf
*.kt          text eol=lf
*.gradle      text eol=lf
*.xml         text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.properties  text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.sh          text eol=lf
*.sql         text eol=lf

# Windows scripts — keep CRLF (cmd.exe / PowerShell)
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binaries — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.jks  binary
*.keystore binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.jar  binary
*.onnx binary
*.mp3  binary
*.mp4  binary
